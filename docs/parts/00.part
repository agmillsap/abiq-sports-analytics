<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Abigail Millsap | Product Portfolio</title>
<style>
:root{--ink:#0a1930;--navy:#0b2347;--navy2:#163d75;--blue:#2a69c7;--sky:#a9d5ff;--muted:#62738a;--line:#dce5ef;--bg:#f4f7fb;--white:#fff;--copper:#a96943}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink);line-height:1.55}a{color:inherit}.shell{max-width:1240px;margin:auto;padding:0 30px}.top{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.top .shell{height:62px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:15px;font-weight:850;letter-spacing:-.02em}.nav{display:flex;gap:28px;font-size:12px;font-weight:750;color:#50627d}.nav a{text-decoration:none}.nav a:hover{color:var(--ink)}
.intro{position:relative;overflow:hidden;background:linear-gradient(108deg,#081a37 0%,#102f62 66%,#1c4f91 100%);color:white;border-bottom:1px solid #2d5793}.intro:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,black,transparent 86%)}.intro .shell{position:relative;padding-top:38px;padding-bottom:38px}.introKicker{font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.12em;color:#b9dbfb;margin-bottom:12px}.intro h1{font-size:clamp(34px,3.2vw,46px);line-height:1.06;letter-spacing:-.045em;margin:0;max-width:none;width:100%}.intro h1 span{color:#a9d9ff}.intro p{max-width:none;width:100%;margin:14px 0 0;font-size:14px;line-height:1.65;color:#d9e7f5}.introMeta{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.introMeta span{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.06);border-radius:999px;padding:6px 9px;font-size:10px;font-weight:700;color:#e7f1fb}
.section{padding:48px 0}.section.white{background:white}.sectionHead{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:24px}.sectionHead h2{font-size:32px;line-height:1.1;letter-spacing:-.035em;margin:0}.sectionHead p{max-width:700px;margin:7px 0 0;color:var(--muted);font-size:13px}.caseGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.case{background:#fff;border:1px solid #d5e0eb;border-radius:14px;overflow:hidden;box-shadow:0 8px 26px rgba(24,48,80,.07);transition:transform .18s ease,box-shadow .18s ease;min-width:0;display:flex;flex-direction:column}.case:hover{transform:translateY(-2px);box-shadow:0 15px 38px rgba(24,48,80,.12)}.case:nth-child(1){border-top:4px solid #143f78}.case:nth-child(2){border-top:4px solid #2d70bc}.case:nth-child(3){border-top:4px solid #9b5a36}.caseMedia{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#0a2347,#184d8a);border-bottom:1px solid var(--line);overflow:hidden;cursor:pointer}.caseMedia:after{content:"Open interactive demo";position:absolute;right:12px;bottom:10px;background:#071f42e8;color:#fff;border:1px solid #ffffff66;border-radius:6px;padding:7px 9px;font-size:9px;font-weight:850;opacity:0;transform:translateY(4px);transition:.16s}.caseMedia:hover:after{opacity:1;transform:none}.case:nth-child(3) .caseMedia:after{content:"Open ABIQ"}.previewViewport{position:relative;width:100%;height:100%;overflow:hidden;background:#fff}.previewFrame{position:absolute;left:0;top:0;width:1600px;height:900px;border:0;transform-origin:0 0;pointer-events:none;background:#fff}.caseMedia img{width:100%;height:100%;object-fit:cover;display:block}.caseBody{padding:19px 19px 20px;display:flex;flex-direction:column;flex:1}.caseType{font-size:9.5px;font-weight:850;text-transform:uppercase;letter-spacing:.11em;color:#2b66b8}.case:nth-child(3) .caseType{color:#8b583d}.case h3{font-size:20px;line-height:1.2;letter-spacing:-.025em;margin:7px 0 8px}.caseBody>p{font-size:12.5px;line-height:1.55;color:var(--muted);margin:0;min-height:78px}.skillsLine{font-size:10.5px;color:#48617e;margin-top:14px;font-weight:750}.caseActions{display:flex;gap:8px;margin-top:15px}.button{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:7px;padding:9px 11px;font-size:10.5px;font-weight:850;border:1px solid #c7d6e8;color:#174f96;background:#fff;cursor:pointer}.button.primary{background:#103d77;border-color:#103d77;color:#fff}.button:hover{filter:brightness(.98)}
.storyList{display:grid;gap:28px}.story{display:grid;grid-template-columns:.8fr 1.2fr;gap:34px;padding:32px 0;border-top:1px solid var(--line)}.story:first-child{border-top:none;padding-top:0}.storyNo{font-size:10px;color:#2b66b8;font-weight:850;text-transform:uppercase;letter-spacing:.12em}.story h3{font-size:27px;line-height:1.12;letter-spacing:-.035em;margin:9px 0 10px}.storyLead{color:var(--muted);font-size:13.5px;max-width:430px}.storyDetails{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.detail{border-left:2px solid #cfdae7;padding-left:14px}.detail b{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#46627f;margin-bottom:6px}.detail p{font-size:12.5px;color:#586b82;margin:0}.processGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.processItem{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}.processItem .n{font-size:9.5px;color:#2b66b8;font-weight:850;letter-spacing:.08em}.processItem h3{font-size:15px;margin:8px 0 6px}.processItem p{font-size:11.5px;color:var(--muted);margin:0}.about{display:grid;grid-template-columns:.65fr 1.35fr;gap:40px;align-items:start}.about h2{font-size:31px;line-height:1.08;letter-spacing:-.04em;margin:0}.about p{font-size:13px;color:var(--muted);margin-top:0}.note{margin-top:15px;padding:13px 15px;background:#f3f7fb;border:1px solid #d9e4ef;border-radius:10px;font-size:11.5px;color:#53677f}.footer{padding:27px 0 38px;color:#748399;font-size:10.5px;text-align:center;border-top:1px solid var(--line);background:white}
#demoShell{position:fixed;inset:0;background:#fff;z-index:1000;display:none}#demoShell.open{display:block}.demoBar{height:52px;background:#081f42;color:#fff;display:flex;align-items:center;gap:12px;padding:0 14px;border-bottom:1px solid #ffffff22}.demoBar button{border:1px solid #ffffff55;background:#ffffff0d;color:#fff;border-radius:6px;padding:8px 11px;font-weight:750;cursor:pointer}.demoTitle{font-weight:800;font-size:13px;flex:1}#demoFrame{width:100%;height:calc(100vh - 52px);border:0;background:#fff}body.demo-open{overflow:hidden}.previewLoading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#d6e6f6;font-size:11px;font-weight:800;background:linear-gradient(135deg,#081f42,#174b89)}
@media(max-width:980px){.caseGrid,.storyDetails,.processGrid{grid-template-columns:1fr 1fr}.story,.about{grid-template-columns:1fr}.nav{display:none}.intro h1{font-size:40px}.case:nth-child(3){grid-column:1/-1;max-width:620px}}@media(max-width:650px){.shell{padding:0 20px}.caseGrid,.storyDetails,.processGrid{grid-template-columns:1fr}.case:nth-child(3){grid-column:auto;max-width:none}.section{padding:42px 0}.sectionHead{align-items:start;flex-direction:column}.intro .shell{padding-top:32px;padding-bottom:32px}.intro h1{font-size:34px}}
</style>
</head>
<body>
<header class="top"><div class="shell"><div class="brand">Abigail Millsap</div><nav class="nav"><a href="#work">Selected Work</a><a href="#approach">How I Work</a><a href="#about">About</a></nav></div></header>
<section class="intro"><div class="shell"><div class="introKicker">Product strategy · decision intelligence · workflow design</div><h1>Decision tools designed to solve <span>complex business problems</span></h1><p>Combining business strategy, analytics, and product design to define the problem, shape the workflow, and build interactive tools that help people move from information to action.</p><div class="introMeta"><span>Problem framing</span><span>Interactive prototyping</span><span>Analytics products</span><span>Enterprise workflows</span></div></div></section>
<section class="section" id="work"><div class="shell"><div class="sectionHead"><div><h2>Selected product work</h2><p>Three products that show how I translate analytical and operational complexity into usable decision workflows.</p></div></div><div class="caseGrid">
<article class="case"><div class="caseMedia" data-demo="field"><div class="previewViewport"><div class="previewLoading">Loading live sample-data preview…</div><iframe class="previewFrame" data-preview="field" title="Live preview of Field Sales Portfolio Optimization"></iframe></div></div><div class="caseBody"><div class="caseType">Enterprise planning product</div><h3>Field Sales Portfolio Optimization</h3><p>Interactive territory and portfolio planning that combines hierarchy drill-in, geospatial review, scenario testing, feasibility checks, and traceable account movement.</p><div class="skillsLine">Scenario design · Geospatial UX · Business rules</div><div class="caseActions"><button class="button primary" data-demo="field">Open interactive demo</button><a class="button" href="#field-story">View case study</a></div></div></article>
<article class="case"><div class="caseMedia" data-demo="market"><div class="previewViewport"><div class="previewLoading">Loading live sample-data preview…</div><iframe class="previewFrame" data-preview="market" title="Live preview of Market Opportunity Navigator"></iframe></div></div><div class="caseBody"><div class="caseType">Market intelligence product</div><h3>Market Opportunity Navigator</h3><p>A multi-user experience for identifying whitespace, drilling into customer relationships, and translating market opportunity into specific seller actions.</p><div class="skillsLine">Information architecture · Role-based workflows · Action design</div><div class="caseActions"><button class="button primary" data-demo="market">Open interactive demo</button><a class="button" href="#market-story">View case study</a></div></div></article>
<article class="case"><a class="caseMedia" href="https://abiq-sports.streamlit.app" target="_blank" rel="noopener"><img alt="ABIQ sports decision intelligence dashboard" src="data:image/png;base64,